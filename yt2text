#!/usr/bin/env bash
# yt2text: Extract transcripts and subtitles from YouTube videos as clean plain text or WebVTT.
set -euo pipefail

PROG_NAME="$(basename "$0")"

usage() {
  cat <<EOF
Usage: $PROG_NAME -u URL -o FILE [options]

Extract subtitles or auto-generated transcripts from any YouTube video.

Required arguments:
  -u URL    YouTube video URL
  -o FILE   Output file path (.txt or .vtt), or '-' for stdout

Optional arguments:
  -l LANG   Preferred subtitle language code (default: 'it', falls back to 'en')
  -t        Keep timing information in original WebVTT format
  -U        Force update the cached yt-dlp binary
  -h        Display this help message

Examples:
  $PROG_NAME -u "https://www.youtube.com/watch?v=VIDEO_ID" -o transcript.txt
  $PROG_NAME -u "https://youtu.be/VIDEO_ID" -o subtitles.vtt -t
  $PROG_NAME -u "https://www.youtube.com/watch?v=VIDEO_ID" -o -
EOF
}

url=""
out=""
lang="it"
keep_timestamps=0
force_update=0

while getopts ":u:o:l:tUh" opt; do
  case "$opt" in
    u) url="$OPTARG" ;;
    o) out="$OPTARG" ;;
    l) lang="$OPTARG" ;;
    t) keep_timestamps=1 ;;
    U) force_update=1 ;;
    h) usage; exit 0 ;;
    :) echo "Error: option -$OPTARG requires a value." >&2; usage; exit 2 ;;
    \?) echo "Error: invalid option -$OPTARG." >&2; usage; exit 2 ;;
  esac
done

if [[ -z "$url" || -z "$out" ]]; then
  echo "Error: both -u URL and -o FILE are required." >&2
  usage
  exit 2
fi

# Basic URL validation
if [[ ! "$url" =~ ^https?:// ]]; then
  echo "Error: URL must start with http:// or https://" >&2
  exit 2
fi

# Manage cached yt-dlp binary to avoid re-downloading on every invocation
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/yt2text"
YTDLP_BIN="$CACHE_DIR/yt-dlp"
mkdir -p "$CACHE_DIR"

if [[ ! -x "$YTDLP_BIN" || $force_update -eq 1 ]]; then
  echo "Downloading latest yt-dlp release..." >&2
  tmp_bin="$CACHE_DIR/yt-dlp.tmp.$$"
  if curl -fsSL 'https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp' -o "$tmp_bin"; then
    chmod +x "$tmp_bin"
    mv "$tmp_bin" "$YTDLP_BIN"
  else
    rm -f "$tmp_bin"
    if [[ ! -x "$YTDLP_BIN" ]]; then
      echo "Error: failed to download yt-dlp and no cached binary was found." >&2
      exit 1
    fi
    echo "Warning: update failed, falling back to cached yt-dlp." >&2
  fi
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# First attempt with requested language
"$YTDLP_BIN" --skip-download --write-subs --write-auto-subs \
  --sub-langs "$lang" --sub-format vtt \
  -o "$tmpdir/captions.%(ext)s" "$url" >/dev/null 2>&1 || true

vtt=$(find "$tmpdir" -maxdepth 1 -type f \( -name "captions.$lang.vtt" -o -name "captions.$lang-*.vtt" \) | head -n1 || true)

# If not found and requested language was not English, fallback to English
if [[ -z "$vtt" || ! -f "$vtt" ]]; then
  if [[ "$lang" != "en" ]]; then
    echo "Subtitles for '$lang' not found; trying English ('en')..." >&2
    "$YTDLP_BIN" --skip-download --write-subs --write-auto-subs \
      --sub-langs 'en' --sub-format vtt \
      -o "$tmpdir/captions.%(ext)s" "$url" >/dev/null 2>&1 || true
    vtt=$(find "$tmpdir" -maxdepth 1 -type f \( -name "captions.en.vtt" -o -name "captions.en-*.vtt" \) | head -n1 || true)
  fi
fi

if [[ -z "$vtt" || ! -f "$vtt" ]]; then
  echo "Error: no subtitles or transcripts available for this video." >&2
  exit 1
fi

if (( keep_timestamps )); then
  if [[ "$out" == "-" ]]; then
    cat "$vtt"
  else
    mkdir -p "$(dirname "$out")"
    cp "$vtt" "$out"
    echo "Subtitles saved to: $out" >&2
  fi
else
  # Clean subtitles into plain text (strip VTT headers, timestamps, HTML tags, and consecutive duplicate lines)
  clean_script='
import html, re, sys
from pathlib import Path

src = Path(sys.argv[1])
dest_path = sys.argv[2]

result = []
for raw_line in src.read_text(encoding="utf-8-sig", errors="replace").splitlines():
    line = raw_line.strip()
    if not line or line == "WEBVTT" or "-->" in line or line.isdigit() or line.startswith(("NOTE", "Kind:", "Language:")):
        continue
    line = html.unescape(re.sub(r"<[^>]*>", "", line)).strip()
    if line and (not result or line != result[-1]):
        result.append(line)

cleaned_text = "\n".join(result) + "\n"
if dest_path == "-":
    sys.stdout.write(cleaned_text)
else:
    Path(dest_path).parent.mkdir(parents=True, exist_ok=True)
    Path(dest_path).write_text(cleaned_text, encoding="utf-8")
'
  python3 -c "$clean_script" "$vtt" "$out"
  if [[ "$out" != "-" ]]; then
    echo "Transcript saved to: $out" >&2
  fi
fi
